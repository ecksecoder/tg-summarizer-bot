# =====================================================================
# AI Context Hub — Пример конфигурации окружения
# Скопируйте этот файл как .env и заполните своими значениями:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# =====================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# [ОБЯЗАТЕЛЬНО] API-ключ Google Gemini (получить бесплатно: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# [ОПЦИОНАЛЬНО] API-ключ Groq для резервной маршрутизации при сбоях (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# [ОПЦИОНАЛЬНО] Разрешенные Telegram ID пользователей через запятую (RBAC контроль доступа).
# Оставьте пустым, чтобы бот был доступен всем пользователям.
# Пример: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
